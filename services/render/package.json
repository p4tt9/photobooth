{
  "name": "snaphora-render",
  "private": true,
  "description": "Bildpipeline der Snaphora-Fotobox: Look, Rahmen, Anzeige-, Galerie- und Druckbilder (libvips/sharp)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/",
    "look:from-lightcraft": "node dist/tools/look-from-lightcraft.js"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/qrcode": "1.5.5",
    "typescript": "5.9.3"
  }
}
