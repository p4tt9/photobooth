#!/usr/bin/env bash
#
# Startet den Kiosk-Browser (Chromium im Wayland-Kiosk-Compositor cage) auf dem Touchscreen.
# Wird vom Kiosk-Benutzer auf tty1 gestartet und bei einem Absturz automatisch neu gestartet.
#
# Zuerst erscheint eine lokale Ladeseite, die auf die App wartet und dann dorthin wechselt.
# So bleibt der Bildschirm beim Hochfahren nie schwarz.

set -euo pipefail

APP_URL="${SNAPHORA_APP_URL:-http://localhost/}"
LOADING_PAGE="/opt/snaphora/box/host/kiosk/loading.html"

# Browser-Profil im RAM (tmpfs): Nach einem Stromausfall gibt es weder ein beschädigtes Profil
# noch die Meldung "Chromium wurde nicht korrekt beendet".
PROFILE_DIR="${XDG_RUNTIME_DIR:-/tmp}/snaphora-chromium"
rm -rf "${PROFILE_DIR}"
mkdir -p "${PROFILE_DIR}"

exec cage -s -- chromium \
    --kiosk \
    --user-data-dir="${PROFILE_DIR}" \
    --no-first-run \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-features=Translate,TranslateUI \
    --disable-pinch \
    --overscroll-history-navigation=0 \
    --autoplay-policy=no-user-gesture-required \
    --check-for-update-interval=31536000 \
    --password-store=basic \
    --ozone-platform=wayland \
    "file://${LOADING_PAGE}?target=${APP_URL}"
